<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application android:label="NED Home Display" android:theme="@android:style/Theme.Holo.NoActionBar.Fullscreen" android:usesCleartextTraffic="true" android:allowBackup="false">
        <activity android:name=".MainActivity" android:screenOrientation="landscape" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
    </application>
</manifest>
